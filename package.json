{
  "name": "daily-meditation-tracker",
  "version": "0.1.0",
  "private": true,
  "description": "Telegram bot that keeps a group's daily Vipassana practice on track",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch --env-file=.env src/index.ts",
    "start": "tsx --env-file=.env src/index.ts",
    "build": "tsc",
    "recompute": "tsx --env-file=.env scripts/recompute.ts"
  },
  "dependencies": {
    "@grammyjs/auto-retry": "^2.0.2",
    "firebase-admin": "^14.5.1",
    "grammy": "^1.46.0",
    "luxon": "^3.7.2"
  },
  "devDependencies": {
    "@types/luxon": "^3.7.6",
    "@types/node": "^26.6.6",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
