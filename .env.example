# Token from @BotFather
BOT_TOKEN=
# Firebase service account key: either a path to the JSON file (local runs)…
GOOGLE_APPLICATION_CREDENTIALS=./service-account.json
# …or the whole JSON base64-encoded (containers): base64 < service-account.json | tr -d '\n'
FIREBASE_SERVICE_ACCOUNT_BASE64=
# Optional: your Telegram user id; receives the weekly CSV backup in DM
OWNER_ID=
